(doc () #f #f ((section (("id" . "djot")) #f #f ((heading () #f #f ((str () #f #f "Djot")) 1 #f) (para () #f #f ((str () #f #f "Djot is a light markup syntax. It derives most of its features from") (soft-break () #f #f) (link () #f #f ((str () #f #f "commonmark")) "https://spec.commonmark.org" #f) (str () #f #f ", but it fixes a few things") (soft-break () #f #f) (str () #f #f "that make commonmark") (str () #f #f "'s syntax complex and difficult to parse") (soft-break () #f #f) (str () #f #f "efficiently. It is also much fuller-featured than commonmark, with") (soft-break () #f #f) (str () #f #f "support for definition lists, footnotes, tables, several new kinds of") (soft-break () #f #f) (str () #f #f "inline formatting (insert, delete, highlight, superscript, subscript),") (soft-break () #f #f) (str () #f #f "math, smart punctuation, attributes that can be applied to any element,") (soft-break () #f #f) (str () #f #f "and generic containers for block-level, inline-level, and raw content."))) (para () #f #f ((str () #f #f "The project began as an attempt to implement some of the ideas I") (soft-break () #f #f) (str () #f #f "suggested in my essay ") (link () #f #f ((str () #f #f "Beyond") (soft-break () #f #f) (str () #f #f "Markdown")) "https://johnmacfarlane.net/beyond-markdown.html" #f) (str () #f #f ". (See") (soft-break () #f #f) (link () #f #f ((str () #f #f "Rationale")) "#rationale" #f) (str () #f #f ", below.)"))) (para () #f #f ((str () #f #f "This repository contains a ") (link () #f #f ((str () #f #f "Syntax") (soft-break () #f #f) (str () #f #f "Description")) "https://htmlpreview.github.io/?https://github.com/jgm/djot/blob/master/doc/syntax.html" #f) (str () #f #f ",") (soft-break () #f #f) (str () #f #f "a ") (link () #f #f ((str () #f #f "Cheatsheet")) "doc/cheatsheet.md" #f) (str () #f #f ", and a ") (link () #f #f ((str () #f #f "Quick Start for Markdown") (soft-break () #f #f) (str () #f #f "Users")) "doc/quickstart-for-markdown-users.md" #f) (str () #f #f " that outlines the main") (soft-break () #f #f) (str () #f #f "differences between djot and Markdown."))) (para () #f #f ((str () #f #f "You can try djot on the ") (link () #f #f ((str () #f #f "djot playground")) "https://djot.net/playground/" #f) (soft-break () #f #f) (str () #f #f "without installing anything locally."))) (section (("id" . "rationale")) #f #f ((heading () #f #f ((str () #f #f "Rationale")) 2 #f) (para () #f #f ((str () #f #f "Here are some design goals:"))) (ordered-list () #f #f ((list-item () #f #f ((para () #f #f ((str () #f #f "It should be possible to parse djot markup in linear time, with no") (soft-break () #f #f) (str () #f #f "backtracking."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "Parsing of inline elements should be ") (str () #f #f "\"local") (str () #f #f "\" and not depend on what") (soft-break () #f #f) (str () #f #f "references are defined later. This is not the case in commonmark:") (soft-break () #f #f) (verbatim () #f #f "[foo][bar]") (str () #f #f " might be ") (str () #f #f "\"") (str () #f #f "[foo") (str () #f #f "]") (str () #f #f "\" followed by a link with text") (soft-break () #f #f) (str () #f #f "\"bar") (str () #f #f "\", or ") (str () #f #f "\"") (str () #f #f "[foo") (str () #f #f "]") (str () #f #f "[bar") (str () #f #f "]") (str () #f #f "\", or a link with text ") (str () #f #f "\"foo") (str () #f #f "\", or a") (soft-break () #f #f) (str () #f #f "link with text ") (str () #f #f "\"foo") (str () #f #f "\" followed by ") (str () #f #f "\"") (str () #f #f "[bar") (str () #f #f "]") (str () #f #f "\", depending on whether") (soft-break () #f #f) (str () #f #f "the references ") (verbatim () #f #f "[foo]") (str () #f #f " and ") (verbatim () #f #f "[bar]") (str () #f #f " are defined elsewhere (perhaps") (soft-break () #f #f) (str () #f #f "later) in the document. This non-locality makes accurate syntax") (soft-break () #f #f) (str () #f #f "highlighting nearly impossible."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "Rules for emphasis should be simpler. The fact that doubled") (soft-break () #f #f) (str () #f #f "characters are used for strong emphasis in commonmark leads to many") (soft-break () #f #f) (str () #f #f "potential ambiguities, which are resolved by a daunting list of 17") (soft-break () #f #f) (str () #f #f "rules. It is hard to form a good mental model of these rules. Most of") (soft-break () #f #f) (str () #f #f "the time they interpret things the way a human would most naturally") (soft-break () #f #f) (str () #f #f "interpret them") (str () #f #f "-") (str () #f #f "--but not always."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "Expressive blind spots should be avoided. In commonmark, you") (str () #f #f "'re out") (soft-break () #f #f) (str () #f #f "of luck if you want to produce the HTML ") (verbatim () #f #f "a<em>?</em>b") (str () #f #f ", because the") (soft-break () #f #f) (str () #f #f "flanking rules classify the first asterisk in ") (verbatim () #f #f "a*?*b") (str () #f #f " as") (soft-break () #f #f) (str () #f #f "right-flanking. There is a way around this, but it") (str () #f #f "'s ugly (using a") (soft-break () #f #f) (str () #f #f "numerical entity instead of ") (verbatim () #f #f "a") (str () #f #f "). In djot there should not be") (soft-break () #f #f) (str () #f #f "expressive blind spots of this kind."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "Rules for what content belongs to a list item should be simple. In") (soft-break () #f #f) (str () #f #f "commonmark, content under a list item must be indented as far as the") (soft-break () #f #f) (str () #f #f "first non-space content after the list marker (or five spaces after") (soft-break () #f #f) (str () #f #f "the marker, in case the list item begins with indented code). Many") (soft-break () #f #f) (str () #f #f "people get confused when their indented content is not indented far") (soft-break () #f #f) (str () #f #f "enough and does not get included in the list item."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "Parsers should not be forced to recognize unicode character classes,") (soft-break () #f #f) (str () #f #f "HTML tags, or entities, or perform unicode case folding. That adds a") (soft-break () #f #f) (str () #f #f "lot of complexity."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "The syntax should be friendly to hard-wrapping: hard-wrapping a") (soft-break () #f #f) (str () #f #f "paragraph should not lead to different interpretations, e.g. when a") (soft-break () #f #f) (str () #f #f "number followed by a period ends up at the beginning of a line. (I") (soft-break () #f #f) (str () #f #f "anticipate that many will ask, why hard-wrap at all? Answer: so that") (soft-break () #f #f) (str () #f #f "your document is readable just as it is, without conversion to HTML") (soft-break () #f #f) (str () #f #f "and without special editor modes that soft-wrap long lines. Remember") (soft-break () #f #f) (str () #f #f "that source readability was one of the prime goals of Markdown and") (soft-break () #f #f) (str () #f #f "Commonmark.)"))))) (list-item () #f #f ((para () #f #f ((str () #f #f "The syntax should compose uniformly, in the following sense: if a") (soft-break () #f #f) (str () #f #f "sequence of lines has a certain meaning outside a list item or block") (soft-break () #f #f) (str () #f #f "quote, it should have the same meaning inside it. This principle is") (soft-break () #f #f) (link () #f #f ((str () #f #f "articulated in the commonmark") (soft-break () #f #f) (str () #f #f "spec")) "https://spec.commonmark.org/0.30/#principle-of-uniformity" #f) (str () #f #f ", but") (soft-break () #f #f) (str () #f #f "the spec doesn") (str () #f #f "'t completely abide by it (see") (soft-break () #f #f) (str () #f #f "commonmark/commonmark-spec#634)."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "It should be possible to attach arbitrary attributes to any element."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "There should be generic containers for text, inline content, and") (soft-break () #f #f) (str () #f #f "block-level content, to which arbitrary attributes can be applied.") (soft-break () #f #f) (str () #f #f "This allows for extensibility using AST transformations."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "The syntax should be kept as simple as possible, consistent with") (soft-break () #f #f) (str () #f #f "these goals. Thus, for example, we don") (str () #f #f "'t need two different styles") (soft-break () #f #f) (str () #f #f "of headings or code blocks.")))))) "1." #f 1) (para () #f #f ((str () #f #f "These goals motivated the following decisions:"))) (bullet-list () #f #f ((list-item () #f #f ((para () #f #f ((str () #f #f "Block-level elements can") (str () #f #f "'t interrupt paragraphs (or headings),") (soft-break () #f #f) (str () #f #f "because of goal 7. So in djot the following is a single paragraph, not") (soft-break () #f #f) (str () #f #f "(as commonmark sees it) a paragraph followed by an ordered list") (soft-break () #f #f) (str () #f #f "followed by a block quote followed by a section heading:"))) (code-block () #f #f #f "My favorite number is probably the number\xa;1. It's the smallest natural number that is\xa;> 0. With pencils, though, I prefer a\xa;# 2.\xa;") (para () #f #f ((str () #f #f "Commonmark does make some concessions to goal 7, by forbidding lists") (soft-break () #f #f) (str () #f #f "beginning with markers other than ") (verbatim () #f #f "1.") (str () #f #f " to interrupt paragraphs. But") (soft-break () #f #f) (str () #f #f "this is a compromise and a sacrifice of regularity and predictability") (soft-break () #f #f) (str () #f #f "in the syntax. Better just to have a general rule."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "An implication of the last decision is that, although ") (str () #f #f "\"tight") (str () #f #f "\" lists") (soft-break () #f #f) (str () #f #f "are still possible (without blank lines between items), a ") (emph () #f #f ((str () #f #f "sublist"))) (soft-break () #f #f) (str () #f #f "must always be preceded by a blank line. Thus, instead of"))) (code-block () #f #f #f "- Fruits\xa;  - apple\xa;  - orange\xa;") (para () #f #f ((str () #f #f "you must write"))) (code-block () #f #f #f "- Fruits\xa;\xa;  - apple\xa;  - orange\xa;") (para () #f #f ((str () #f #f "(This blank line doesn") (str () #f #f "'t count against ") (str () #f #f "\"tightness.") (str () #f #f "\")") (soft-break () #f #f) (str () #f #f "reStructuredText makes the same design decision."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "Also to promote goal 7, we allow headings to ") (str () #f #f "\"lazily") (str () #f #f "\" span multiple") (soft-break () #f #f) (str () #f #f "lines:"))) (code-block () #f #f #f "## My excessively long section heading is too\xa;long to fit on one line.\xa;") (para () #f #f ((str () #f #f "While we") (str () #f #f "'re at it, we") (str () #f #f "'ll simplify by removing setext-style") (soft-break () #f #f) (str () #f #f "(underlined) headings. We don") (str () #f #f "'t really need two heading syntaxes") (soft-break () #f #f) (str () #f #f "(goal 11)."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "To meet goal 5, we have a very simple rule: anything that is indented") (soft-break () #f #f) (str () #f #f "beyond the start of the list marker belongs in the list item."))) (code-block () #f #f #f "1. list item\xa;\xa;  > block quote inside item 1\xa;\xa;2. second item\xa;") (para () #f #f ((str () #f #f "In commonmark, this would be parsed as two separate lists with a block") (soft-break () #f #f) (str () #f #f "quote between them, because the block quote is not indented far") (soft-break () #f #f) (str () #f #f "enough. What kept us from using this simple rule in commonmark was") (soft-break () #f #f) (str () #f #f "indented code blocks. If list items are going to contain an indented") (soft-break () #f #f) (str () #f #f "code block, we need to know at what column to start counting the") (soft-break () #f #f) (str () #f #f "indentation, so we fixed on the column that makes the list look best") (soft-break () #f #f) (str () #f #f "(the first column of non-space content after the marker):"))) (code-block () #f #f #f "1.  A commonmark list item with an indented code block in it.\xa;\xa;        code!\xa;") (para () #f #f ((str () #f #f "In djot, we just get rid of indented code blocks. Most people prefer") (soft-break () #f #f) (str () #f #f "fenced code blocks anyway, and we don") (str () #f #f "'t need two different ways of") (soft-break () #f #f) (str () #f #f "writing code blocks (goal 11)."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "To meet goal 6 and to avoid the complex rules commonmark adopted for") (soft-break () #f #f) (str () #f #f "handling raw HTML, we simply do not allow raw HTML, except in") (soft-break () #f #f) (str () #f #f "explicitly marked contexts, e.g. ") (verbatim () #f #f "`<a id=\"foo\">`{=html}") (str () #f #f " or"))) (code-block () #f #f #f "``` =html\xa;<table>\xa;<tr><td>foo</td></tr>\xa;</table>\xa;```\xa;") (para () #f #f ((str () #f #f "Unlike Markdown, djot is not HTML-centric. Djot documents might be") (soft-break () #f #f) (str () #f #f "rendered to a variety of different formats, so although we want to") (soft-break () #f #f) (str () #f #f "provide the flexibility to include raw content in any output format,") (soft-break () #f #f) (str () #f #f "there is no reason to privilege HTML. For similar reasons we do not") (soft-break () #f #f) (str () #f #f "interpret HTML entities, as commonmark does."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "To meet goal 2, we make reference link parsing local. Anything that") (soft-break () #f #f) (str () #f #f "looks like ") (verbatim () #f #f "[foo][bar]") (str () #f #f " or ") (verbatim () #f #f "[foo][]") (str () #f #f " gets treated as a reference link,") (soft-break () #f #f) (str () #f #f "regardless of whether ") (verbatim () #f #f "[foo]") (str () #f #f " is defined later in the document. A") (soft-break () #f #f) (str () #f #f "corollary is that we must get rid of shortcut link syntax, with just a") (soft-break () #f #f) (str () #f #f "single bracket pair, ") (verbatim () #f #f "[like this]") (str () #f #f ". It must always be clear what is a") (soft-break () #f #f) (str () #f #f "link without needing to know the surrounding context."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "In support of goal 6, reference links are no longer case-insensitive.") (soft-break () #f #f) (str () #f #f "Supporting this beyond an ASCII context would require building in") (soft-break () #f #f) (str () #f #f "unicode case folding to every implementation, and it doesn") (str () #f #f "'t seem") (soft-break () #f #f) (str () #f #f "necessary."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "A space or newline is required after ") (verbatim () #f #f ">") (str () #f #f " in block quotes, to avoid the") (soft-break () #f #f) (str () #f #f "violations of the principle of uniformity noted in goal 8:"))) (code-block () #f #f #f ">This is not a\xa;>block quote in djot.\xa;"))) (list-item () #f #f ((para () #f #f ((str () #f #f "To meet goal 3, we avoid using doubled characters for strong emphasis.") (soft-break () #f #f) (str () #f #f "Instead, we use ") (verbatim () #f #f "_") (str () #f #f " for emphasis and ") (verbatim () #f #f "*") (str () #f #f " for strong emphasis. Emphasis") (soft-break () #f #f) (str () #f #f "can begin with one of these characters, as long as it is not followed") (soft-break () #f #f) (str () #f #f "by a space, and will end when a similar character is encountered, as") (soft-break () #f #f) (str () #f #f "long as it is not preceded by a space and some different characters") (soft-break () #f #f) (str () #f #f "have occurred in between. In the case of overlap, the first one to be") (soft-break () #f #f) (str () #f #f "closed takes precedence. (This simple rule also avoids the need we had") (soft-break () #f #f) (str () #f #f "in commonmark to determine unicode character classes") (str () #f #f "-") (str () #f #f "--goal 6.)"))))) (list-item () #f #f ((para () #f #f ((str () #f #f "Taken just by itself, this last change would introduce a number of") (soft-break () #f #f) (str () #f #f "expressive blind spots. For example, given the simple rule,"))) (code-block () #f #f #f "_(_foo_)_\xa;") (para () #f #f ((str () #f #f "parses as"))) (code-block () #f #f "html" "<em>(</em>foo<em>)</em>\xa;") (para () #f #f ((str () #f #f "rather than"))) (code-block () #f #f "html" "<em>(<em>foo</em>)</em>\xa;") (para () #f #f ((str () #f #f "If you want the latter interpretation, djot allows you to use the") (soft-break () #f #f) (str () #f #f "syntax"))) (code-block () #f #f #f "_({_foo_})_\xa;") (para () #f #f ((str () #f #f "The ") (verbatim () #f #f "{_") (str () #f #f " is a ") (verbatim () #f #f "_") (str () #f #f " that can only open emphasis, and the ") (verbatim () #f #f "_}") (str () #f #f " is a ") (verbatim () #f #f "_") (soft-break () #f #f) (str () #f #f "that can only close emphasis. The same can be done with ") (verbatim () #f #f "*") (str () #f #f " or any") (soft-break () #f #f) (str () #f #f "other inline formatting marker that is ambiguous between an opener and") (soft-break () #f #f) (str () #f #f "closer. These curly braces are ") (emph () #f #f ((str () #f #f "required"))) (str () #f #f " for certain inline markup,") (soft-break () #f #f) (str () #f #f "e.g. ") (verbatim () #f #f "{=highlighting=}") (str () #f #f ", ") (verbatim () #f #f "{+insert+}") (str () #f #f ", and ") (verbatim () #f #f "{-delete-}") (str () #f #f ", since the") (soft-break () #f #f) (str () #f #f "characters ") (verbatim () #f #f "=") (str () #f #f ", ") (verbatim () #f #f "+") (str () #f #f ", and ") (verbatim () #f #f "-") (str () #f #f " are found often in ordinary text."))))) (list-item () #f #f ((para () #f #f ((str () #f #f "In support of goal 1, code span parsing does not backtrack. So if you") (soft-break () #f #f) (str () #f #f "open a code span and don") (str () #f #f "'t close it, it extends to the end of the") (soft-break () #f #f) (str () #f #f "paragraph. That is similar to the way fenced code blocks work in") (soft-break () #f #f) (str () #f #f "commonmark."))) (code-block () #f #f #f "This is `inline code.\xa;"))) (list-item () #f #f ((para () #f #f ((str () #f #f "In support of goal 9, a generic attribute syntax is introduced.") (soft-break () #f #f) (str () #f #f "Attributes can be attached to any block-level element by putting them") (soft-break () #f #f) (str () #f #f "on the line before it, and to any inline-level element by putting them") (soft-break () #f #f) (str () #f #f "directly after it."))) (code-block () #f #f #f "{#introduction}\xa;This is the introductory paragraph, with\xa;an identifier `introduction`.\xa;\xa;           {.important color=\"blue\" #heading}\xa;## heading\xa;\xa;The word *atelier*{weight=\"600\"} is French.\xa;"))) (list-item () #f #f ((para () #f #f ((str () #f #f "Since we are going to have generic attributes, we no longer support") (soft-break () #f #f) (str () #f #f "quoted titles in links. One can add a title attribute if needed, but") (soft-break () #f #f) (str () #f #f "this isn") (str () #f #f "'t very common, so we don") (str () #f #f "'t need a special syntax for it:"))) (code-block () #f #f #f "[Link text](url){title=\"Click me!\"}\xa;"))) (list-item () #f #f ((para () #f #f ((str () #f #f "Fenced divs and bracketed spans are introduced in order to allow") (soft-break () #f #f) (str () #f #f "attributes to be attached to arbitrary sequences of block-level or") (soft-break () #f #f) (str () #f #f "inline-level elements. For example,"))) (code-block () #f #f #f "{#warning .sidebar}\xa;::: Warning\xa;This is a warning.\xa;Here is a word in [français]{lang=fr}.\xa;:::\xa;")))) "-" #f)) #f) (section (("id" . "syntax")) #f #f ((heading () #f #f ((str () #f #f "Syntax")) 2 #f) (para () #f #f ((str () #f #f "For a full syntax reference, see the ") (link () #f #f ((str () #f #f "syntax") (soft-break () #f #f) (str () #f #f "description")) "https://htmlpreview.github.io/?https://github.com/jgm/djot/blob/master/doc/syntax.html" #f) (str () #f #f "."))) (para () #f #f ((str () #f #f "A vim syntax highlighting definition for djot is provided in") (soft-break () #f #f) (verbatim () #f #f "editors/vim/") (str () #f #f ".")))) #f) (section (("id" . "implementations")) #f #f ((heading () #f #f ((str () #f #f "Implementations")) 2 #f) (para () #f #f ((str () #f #f "There are currently two complete djot implementations:"))) (bullet-list () #f #f ((list-item () #f #f ((para () #f #f ((link () #f #f ((str () #f #f "djot.js")) "https://github.com/jgm/djot.js" #f) (str () #f #f " is a JavaScript (actually") (soft-break () #f #f) (str () #f #f "TypeScript) library and command-line tool. It includes a djot renderer") (soft-break () #f #f) (str () #f #f "and a converter between pandoc and djot ASTs, allowing conversion") (soft-break () #f #f) (str () #f #f "between djot and many other formats."))))) (list-item () #f #f ((para () #f #f ((link () #f #f ((str () #f #f "djot.lua")) "https://github.com/jgm/djot.lua" #f) (str () #f #f " is a Lua library and") (soft-break () #f #f) (str () #f #f "command-line tool, with no dependencies. It includes a Makefile that") (soft-break () #f #f) (str () #f #f "can produce a static C library that can be linked with liblua in a") (soft-break () #f #f) (str () #f #f "standalone executable. It also includes a custom reader and writer for") (soft-break () #f #f) (str () #f #f "djot that can be used for interoperability with pandoc, allowing") (soft-break () #f #f) (str () #f #f "conversion between djot and many other formats.")))))) "-" #f) (para () #f #f ((str () #f #f "Both implementations support filters, small programs that can alter the") (soft-break () #f #f) (str () #f #f "AST after parsing, allowing djot to be customized to your needs."))) (para () #f #f ((str () #f #f "djot.lua was the original reference implementation, but current") (soft-break () #f #f) (str () #f #f "development is focused on djot.js, and it is possible that djot.lua will") (soft-break () #f #f) (str () #f #f "not be kept up to date with the latest syntax changes.")))) #f) (section (("id" . "file-extension")) #f #f ((heading () #f #f ((str () #f #f "File extension")) 2 #f) (para () #f #f ((str () #f #f "The extension ") (verbatim () #f #f ".dj") (str () #f #f " may be used to indicate that the contents of a file") (soft-break () #f #f) (str () #f #f "are djot-formatted text.")))) #f) (section (("id" . "license")) #f #f ((heading () #f #f ((str () #f #f "License")) 2 #f) (para () #f #f ((str () #f #f "The code and documentation are released under the MIT license.")))) #f)) #f)) () (("Djot" . (reference () #f #f "Djot" "#djot")) ("Rationale" . (reference () #f #f "Rationale" "#rationale")) ("Syntax" . (reference () #f #f "Syntax" "#syntax")) ("Implementations" . (reference () #f #f "Implementations" "#implementations")) ("File extension" . (reference () #f #f "File extension" "#file-extension")) ("License" . (reference () #f #f "License" "#license"))) () #f)
